{
  "name": "@pixpilot/firebase-auth-emulator",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@10.34.9",
  "description": "Run the Firebase Auth Emulator with automatic ports and child-command lifecycle management.",
  "author": "Mo Doaie <m.doaie@hotmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pixpilot/firebase-tools.git",
    "directory": "packages/auth-emulator"
  },
  "keywords": [],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    },
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "firebase-auth-emulator": "./dist/cli.js"
    }
  },
  "sideEffects": false,
  "exports": "./src/index.ts",
  "bin": {
    "firebase-auth-emulator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "git clean -xdf .cache .turbo dist",
    "clean:all": "pnpm clean && git clean -xdf node_modules",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@pixpilot/net": "catalog:runtime"
  },
  "devDependencies": {
    "@internal/eslint-config": "workspace:*",
    "@internal/prettier-config": "workspace:*",
    "@internal/tsconfig": "workspace:*",
    "@internal/tsdown-config": "workspace:*",
    "@internal/vitest-config": "workspace:*",
    "@pixpilot/dev-config": "catalog:config",
    "@types/node": "catalog:typescript",
    "tsdown": "catalog:build",
    "typescript": "catalog:typescript",
    "vitest": "catalog:testing"
  }
}
